APP_NAME=login-plans
APP_ENV=development
DEBUG=false

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE_TEST

# Optional: Redis for distributed rate limiting (falls back to in-memory)
# REDIS_URL=redis://localhost:6379/0

# Optional: OpenTelemetry
# OTLP_ENDPOINT=http://jaeger:4317
# ENABLE_TRACING=true

