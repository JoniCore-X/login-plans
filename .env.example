APP_NAME=login-plans
APP_ENV=development
DEBUG=false

# Matches docker-compose.yml dev credentials (local only — never reuse in production)
DATABASE_URL=postgresql+asyncpg://login_plans:login_plans_dev_password@localhost:5432/login_plans

TEST_DATABASE_URL=postgresql+asyncpg://login_plans:login_plans_dev_password@localhost:5432/login_plans_test

# Redis for distributed rate limiting (redis service in docker compose)
REDIS_URL=redis://localhost:6379/0

# Optional: OpenTelemetry (jaeger service in docker compose)
# OTLP_ENDPOINT=http://localhost:4317
# ENABLE_TRACING=true

# Optional: Resend for real email delivery (falls back to console logs)
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# EMAIL_FROM=noreply@tudominio.com
# EMAIL_VERIFY_BASE_URL=https://tudominio.com/verify
