# ─── Producción — copiar a .env.production y rellenar ───
# NUNCA commitear .env.production con valores reales.

# Requeridos — el compose falla si están vacíos
POSTGRES_PASSWORD=CAMBIAR_password_largo_aleatorio
CORS_ORIGINS=https://tudominio.com

# Email real (requerido en producción — sin esto el token de
# verificación nunca llega al usuario; el adaptador Resend ya existe)
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=noreply@tudominio.com
EMAIL_VERIFY_BASE_URL=https://tudominio.com/verify

# Opcionales
OTLP_ENDPOINT=            # vacío = tracing desactivado, o endpoint de tu collector
ENABLE_TRACING=false
APP_PORT=8000
